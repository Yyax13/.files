alias _h='htb-hosts'
alias hg='_h get'
alias ha='_h add'
alias hl='_h show'
alias hc='_h clear'
alias hr='_h rm'

hh () {
  echo "HTB-Hosts Usage:"
  echo "   _h   -  Internal alias for htb-hosts"
  echo "   hg   -  Get"
  echo "   ha   -  Add"
  echo "   hl   -  Show/List"
  echo "   hc   -  Clear"
  echo "   hr   -  Remove"
  echo "   hh   -  Help (show this menu)"
}

